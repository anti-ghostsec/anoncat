// The interface between anoncat and its plugins.
//
// A plugin is a WebAssembly component (e.g. Rust built for wasm32-wasip2)
// that exports the functions in `world plugin` and may call the `host`
// functions. It runs sandboxed: no files, network, environment or clock
// beyond what WASI gives an empty context, a memory cap, and a time limit
// on every call.
package anoncat:plugin@0.1.0;

interface types {
	/// A room event as plugins see it.
	record event {
		/// Empty for an event being checked before it is created.
		event-id: string,
		room-id: string,
		sender: string,
		/// The event type, e.g. "m.room.message".
		kind: string,
		state-key: option<string>,
		/// The event content as JSON.
		content: string,
		origin-server-ts: u64,
	}

	/// What `check-event` decides.
	variant verdict {
		allow,
		/// Refuse the event; the reason is shown to the sender.
		reject(string),
	}
}

interface host {
	enum level { error, warn, info, debug }

	/// Writes to the server log, tagged with the plugin's name.
	log: func(level: level, message: string);

	/// The plugin's own key-value storage, kept in the database.
	kv-get: func(key: string) -> option<list<u8>>;
	kv-set: func(key: string, value: list<u8>);
	kv-delete: func(key: string);

	/// Sends a text message as the server's bot account, which must be in the
	/// room. Needs the `send_messages` capability. Messages are queued and
	/// sent after the current call returns.
	send-message: func(room-id: string, body: string) -> result<_, string>;
}

world plugin {
	use types.{event, verdict};
	import host;

	/// Called once after loading, with the manifest's `config` as JSON.
	export init: func(config: string) -> result<_, string>;

	/// Called before a local user's message is accepted, with the
	/// `check_events` capability. Must be quick.
	export check-event: func(event: event) -> verdict;

	/// Called after an event is stored, for the event types the manifest
	/// subscribes to.
	export on-event: func(event: event);

	/// Called by `!admin plugins call <name> <args...>`; the result is shown to
	/// the admin.
	export on-command: func(args: list<string>) -> string;
}
