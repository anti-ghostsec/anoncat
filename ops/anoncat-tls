#!/bin/bash
# anoncat-tls: keep anoncat's Let's Encrypt certificate current (DNS-01
# through Dynu, see acme-dynu-hook.py). Run by anoncat-tls-renew.service.
#
# A fresh certificate when it lacks one of DOMAINS (lego's renew keeps the
# old names), otherwise a renewal when under 30 days are left. Either way a
# new certificate leaves TLS/renewed behind, and the service restarts anoncat
# in place to load it.
set -euo pipefail

TLS=/Drives/server/data/tls
DOMAINS=(anoncat.gleeze.com hs.anoncat.gleeze.com)
CERT=$TLS/certificates/${DOMAINS[0]}.crt

args=(--accept-tos --path "$TLS" --email "admin@${DOMAINS[0]}" --dns exec --dns.disable-cp)
for d in "${DOMAINS[@]}"; do args+=(--domains "$d"); done

missing=0
if [[ -f $CERT ]]; then
	sans=$(openssl x509 -in "$CERT" -noout -ext subjectAltName)
	for d in "${DOMAINS[@]}"; do
		grep -q "DNS:$d\b" <<<"$sans" || missing=1
	done
else
	missing=1
fi

if (( missing )); then
	echo "Certificate doesn't cover ${DOMAINS[*]}; requesting a new one."
	lego "${args[@]}" run
	touch "$TLS/renewed"
else
	lego "${args[@]}" renew --days 30 --renew-hook "/usr/bin/touch $TLS/renewed"
fi
