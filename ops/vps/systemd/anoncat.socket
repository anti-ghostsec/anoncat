# anoncat on the VPS: systemd holds the public sockets, so connections queue
# instead of being refused while the server restarts or updates. 443 for apps
# and the front page, 8448 for other Matrix servers.
[Unit]
Description=anoncat Matrix homeserver socket

[Socket]
ListenStream=443
ListenStream=8448
BindIPv6Only=both
Backlog=1024
NoDelay=true

[Install]
WantedBy=sockets.target
