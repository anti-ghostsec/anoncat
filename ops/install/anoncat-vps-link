#!/bin/bash
# anoncat-vps-link: the WireGuard tunnel from this (home) PC to anoncat's main
# server, the VPS. Run as root with the VPN (wg0) up:
#
#   sudo anoncat-vps-link <vps-address> <vps-wireguard-port> <vps-public-key>
#
# Home is the VPS's standby: backups and old media come here through this
# tunnel, and SSH to the VPS goes through it. It runs inside Proton (wg0), so
# the VPS never learns the home address; if wg0 is down, the tunnel's
# packets are dropped rather than sent the other way.
#
# Safe to run again. Prints this PC's tunnel key at the end, for the VPS:
#   ssh op@<vps> sudo home-peer <key>
set -euo pipefail

IFACE=anoncat-vps
HOME_ADDR=10.78.0.2
VPS_ADDR=10.78.0.1
MTU=1340  # wg0's 1420, less this tunnel's own 80 bytes
LIB=/usr/local/lib/anoncat

die() { echo "anoncat-vps-link: $*" >&2; exit 1; }
step() { echo; echo "== $*"; }

[[ $EUID -eq 0 ]] || die "run as root"
[[ $# -eq 3 ]] || die "usage: $0 <vps-address> <vps-wireguard-port> <vps-public-key>"
vps=$1 port=$2 vps_key=$3
[[ $vps =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "$vps isn't an IPv4 address"
[[ $port =~ ^[0-9]{1,5}$ ]] || die "$port isn't a port"
[[ $vps_key =~ ^[A-Za-z0-9+/]{43}=$ ]] || die "$vps_key isn't a WireGuard public key"
ip link show wg0 &>/dev/null || die "wg0 is down; bring the VPN up first"
[[ $(ip route get "$vps" 2>/dev/null) == *"dev wg0"* ]] || die "$vps isn't routed through wg0; refusing, it would see the home address"

step "Tunnel"
install -d -m 0700 /etc/wireguard
install -d -m 0755 /etc/anoncat
umask 077
[[ -f /etc/wireguard/$IFACE.key ]] || wg genkey > "/etc/wireguard/$IFACE.key"
umask 022
wg pubkey < "/etc/wireguard/$IFACE.key" > /etc/anoncat/vps-link.pub
cat > "/etc/wireguard/$IFACE.conf" <<CONF
# Written by anoncat-vps-link. The tunnel to anoncat's main server.
[Interface]
PrivateKey = $(cat "/etc/wireguard/$IFACE.key")
Address = $HOME_ADDR/32
MTU = $MTU
# Proton or nothing: the tunnel's own packets to the VPS may only leave on wg0.
PostUp = nft -f /etc/anoncat/vps-guard.nft
PreDown = nft delete table inet anoncat-vps-guard || true

[Peer]
PublicKey = $vps_key
Endpoint = $vps:$port
# Only the VPS's tunnel address: this PC's own traffic never goes this way.
AllowedIPs = $VPS_ADDR/32
PersistentKeepalive = 25
CONF
chmod 0600 "/etc/wireguard/$IFACE.conf"
cat > /etc/anoncat/vps-guard.nft <<NFT
table inet anoncat-vps-guard
delete table inet anoncat-vps-guard
table inet anoncat-vps-guard {
	chain output {
		type filter hook output priority filter; policy accept;
		ip daddr $vps udp dport $port oifname != "wg0" counter drop
	}
}
NFT
install -d -m 0755 "/etc/systemd/system/wg-quick@$IFACE.service.d"
cat > "/etc/systemd/system/wg-quick@$IFACE.service.d/anoncat.conf" <<UNIT
[Unit]
# Inside Proton's tunnel, so after it.
After=sys-subsystem-net-devices-wg0.device
UNIT

step "Kill switch"
# FerroOS's kill switch lets traffic out only through wg0 and rebuilds its
# rules on every VPN reconnect. This tunnel runs inside wg0, so it's let
# through, and kept let through after each rebuild.
install -d -m 0755 "$LIB"
cat > "$LIB/allow-out" <<'SH'
#!/bin/bash
# allow-out IFACE...: keep FerroOS's kill switch letting these tunnels (which
# run inside wg0) through; checked every 15 s, since it's rebuilt on reconnect.
while :; do
	if chain=$(nft list chain inet ferro_vpn filter_out 2>/dev/null); then
		for iface in "$@"; do
			grep -qF "oifname \"$iface\" accept" <<<"$chain" ||
				nft insert rule inet ferro_vpn filter_out oifname "\"$iface\"" accept
		done
	fi
	sleep 15
done
SH
chmod 0755 "$LIB/allow-out"
cat > /etc/systemd/system/anoncat-allow-out.service <<UNIT
[Unit]
Description=Let anoncat's tunnels through the VPN kill switch

[Service]
ExecStart=$LIB/allow-out $IFACE
Restart=always
RestartSec=5
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload

step "Start"
systemctl enable --now anoncat-allow-out.service >/dev/null 2>&1
systemctl enable "wg-quick@$IFACE.service" >/dev/null 2>&1
systemctl restart "wg-quick@$IFACE.service"
systemctl --no-pager status "wg-quick@$IFACE.service" anoncat-allow-out.service | grep -E "●|Active:" || true
echo
echo "This PC's tunnel key; on the VPS run:  sudo home-peer $(cat /etc/anoncat/vps-link.pub)"
