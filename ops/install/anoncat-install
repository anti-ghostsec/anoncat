#!/bin/bash
# anoncat-install: put anoncat live on this machine. Run as root, with the
# vault unlocked and the VPN (wg0) up:
#
#   sudo ops/install/anoncat-install /path/to/release/tuwunel
#
# Safe to run again: each step checks before it changes anything, and
# nothing that already exists in the vault (config, keys, certificates,
# database) is overwritten. Later binary updates use anoncat-update instead.
set -euo pipefail

OPS=$(cd "$(dirname "$0")/.." && pwd)
DATA=/Drives/server/data
OLD_TLS=/Drives/server/tls
OLD_KEY=/home/nully/.config/anoncat/dynu-key
USER_=anoncat
BIN=/usr/local/bin/anoncat
LIB=/usr/local/lib/anoncat
SBIN=/usr/local/sbin
UNITS=(anoncat.socket anoncat.service anoncat-netd.service anoncat-tls-renew.service anoncat-tls-renew.timer
	anoncat-backup.service anoncat-backup.timer anoncat-vault-helper.socket anoncat-vault-helper@.service
	anoncat-unlock.service anoncat-start.service anoncat-reconnect.service
	anoncat-video.socket anoncat-video@.service)
INPUT_RULE='iifname "wg0" tcp dport 8448 accept'

die() { echo "anoncat-install: $*" >&2; exit 1; }
step() { echo; echo "== $*"; }

[[ $EUID -eq 0 ]] || die "run as root"
[[ $# -eq 1 && -f $1 ]] || die "usage: $0 /path/to/release/tuwunel"
mountpoint -q "$DATA" || die "$DATA isn't mounted; run: anoncat-vault unlock"
ip link show wg0 &>/dev/null || die "wg0 is down; bring the VPN up first"
id "$USER_" &>/dev/null || die "no $USER_ user"

step "Binary"
staged=$(mktemp "$BIN.staged.XXXXXX")
trap 'rm -f "$staged"' EXIT
cp "$1" "$staged"
chown root:root "$staged"
chmod 0755 "$staged"
version=$(runuser -u "$USER_" -- "$staged" --version 2>/dev/null | head -1)
[[ -n $version ]] || die "$1 doesn't run"
if cmp -s "$staged" "$BIN"; then
	echo "already installed: $version"
else
	mv -f "$staged" "$BIN"
	echo "installed $version"
fi

step "Tools"
install -d -m 0755 "$LIB"
install -m 0755 "$OPS/anoncat-netd.py" "$OPS/acme-dynu-hook.py" "$OPS/anoncat-tls" "$LIB/"
install -m 0755 "$OPS/vault/anoncat-vault-helper" "$OPS/vault/anoncat-unlock-page" "$LIB/"
install -m 0755 "$OPS/video/anoncat-video" "$OPS/video/anoncat-video-helper" "$LIB/"
install -d -m 0755 "$LIB/unlock"
install -m 0644 "$OPS/vault/unlock/unlock.html" "$OPS/vault/unlock/unlock.js" "$OPS/../src/router/panel/panel.css" "$LIB/unlock/"
install -m 0755 "$OPS/vault/anoncat-vault" "$OPS/update/anoncat-update" "$OPS/backup/anoncat-backup" "$OPS/install/anoncat-relay" "$SBIN/"
echo "$LIB: anoncat-netd.py, acme-dynu-hook.py, anoncat-tls, anoncat-vault-helper, anoncat-unlock-page, unlock/"
echo "$SBIN: anoncat-vault, anoncat-update, anoncat-backup, anoncat-relay"

step "System config"
install -d -m 0755 /etc/anoncat
install -m 0644 "$OPS/systemd/resolv.conf" /etc/anoncat/resolv.conf
install -m 0644 "$OPS/systemd/journald@anoncat.conf" /etc/systemd/journald@anoncat.conf
for unit in "${UNITS[@]}"; do
	install -m 0644 "$OPS/systemd/$unit" /etc/systemd/system/
done
systemctl daemon-reload
echo "DNS via Proton for anoncat only, RAM-only logs, ${#UNITS[@]} units"

step "This machine's own access"
# Matrix apps here can't reach the public address (the tunnel doesn't carry
# it back), so the hidden server name points at the tunnel address, where
# anoncat-netd turns the public port into the local listener.
HOSTS_LINE="10.2.0.2 hs.anoncat.gleeze.com"
if ! grep -qxF "$HOSTS_LINE" /etc/hosts; then
	echo "$HOSTS_LINE" >> /etc/hosts
	echo "added to /etc/hosts: $HOSTS_LINE"
fi

step "Vault contents"
install -d -m 0700 -o "$USER_" -g "$USER_" "$DATA/db" "$DATA/secrets" "$DATA/netd" "$DATA/tls" "$DATA/backups"
if [[ ! -e $DATA/tls/certificates ]]; then
	[[ -d $OLD_TLS/certificates ]] || die "no certificate in $OLD_TLS to move into the vault"
	cp -a "$OLD_TLS/." "$DATA/tls/"
	echo "certificate copied into the vault"
fi
if [[ ! -e $DATA/secrets/dynu-key ]]; then
	[[ -f $OLD_KEY ]] || die "no Dynu key at $OLD_KEY"
	install -m 0600 "$OLD_KEY" "$DATA/secrets/dynu-key"
	echo "Dynu key copied into the vault"
fi
if [[ ! -e $DATA/anoncat.toml ]]; then
	token=$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 32)
	sed "s/@REGISTRATION_TOKEN@/$token/" "$OPS/config/anoncat.toml" > "$DATA/anoncat.toml"
	chmod 0600 "$DATA/anoncat.toml"
	echo "config written; registration token: $token"
else
	echo "config already there; left as it is"
	# Settings added since it was written.
	if ! grep -q '^ai_key_file' "$DATA/anoncat.toml"; then
		sed -i '/^admin_panel_address/a\
\
# The AI service'"'"'s key for the panel'"'"'s AI moderation (Settings page).\
ai_key_file = "/Drives/server/data/secrets/venice"' "$DATA/anoncat.toml"
		echo "config: added ai_key_file"
	fi
	if ! grep -q '^database_backup_path' "$DATA/anoncat.toml"; then
		sed -i '/^admin_panel_address/a\
\
# Online database backups, inside the vault (ops/backup/README.md). The\
# daily anoncat-backup timer asks for one with SIGUSR2.\
database_backup_path = "/Drives/server/data/backups"\
database_backups_to_keep = 2\
admin_signal_execute = ["server backup-database"]' "$DATA/anoncat.toml"
		echo "config: added database backups"
	fi
	# Two daily backups, as the rules page promises ("up to 2 more days").
	if grep -qx 'database_backups_to_keep = 7' "$DATA/anoncat.toml"; then
		sed -i 's/^database_backups_to_keep = 7$/database_backups_to_keep = 2/' "$DATA/anoncat.toml"
		echo "config: two backups kept, as the rules page says"
	fi
	if ! grep -q '^media_video_thumbnail_command' "$DATA/anoncat.toml"; then
		sed -i '/^admin_panel_address/a\
# Video previews: one still frame per video, taken by ffmpeg at lowest\
# priority, one at a time (media_video_thumbnail_concurrency), so videos show\
# a picture in clients and in the panel instead of a grey box.\
media_video_thumbnail_command = ["nice", "-n", "19", "ffmpeg", "-nostdin", "-loglevel", "error", "-threads", "1", "-protocol_whitelist", "file", "-format_whitelist", "mov,mp4,m4a,3gp,3g2,mj2,matroska,webm,ogg,avi,mpegts,flv", "-i", "{input}", "-vf", "thumbnail=30", "-frames:v", "1", "-f", "image2pipe", "-c:v", "mjpeg", "pipe:1"]' "$DATA/anoncat.toml"
		echo "config: added video previews"
	fi
	# Uploads up to 1 GiB, but every other request small: bodies are read
	# before sign-in is checked, so a big limit for all of them let anyone
	# run the server out of memory.
	# ffmpeg runs in its own sandboxed unit (ops/video/README.md), never
	# inside the server: thumbnails, frame sheets and playable copies all go
	# through the worker.
	if ! grep -q '^media_video_worker' "$DATA/anoncat.toml"; then
		sed -i 's|^media_video_thumbnail_command = .*$|media_video_thumbnail_command = ["/usr/local/lib/anoncat/anoncat-video", "frame", "{input}"]\nmedia_video_worker = "/usr/local/lib/anoncat/anoncat-video"|' "$DATA/anoncat.toml"
		echo "config: video work moved to the sandboxed worker"
	fi
	# Uploads go after 90 days, as the rules page promises, not only the
	# messages that carried them.
	if ! grep -q '^cleanup_local_media_max_age' "$DATA/anoncat.toml" \
		&& grep -q '^cleanup_media_message_max_age' "$DATA/anoncat.toml"; then
		sed -i '/^cleanup_media_message_max_age/a\
cleanup_local_media_max_age = "90d"' "$DATA/anoncat.toml"
		echo "config: uploads deleted 90 days after upload"
	fi
	# ffmpeg reads only the staged file, as a common video container: no
	# playlists opening other files or URLs.
	if grep -q '^media_video_thumbnail_command' "$DATA/anoncat.toml" \
		&& ! grep -q '^media_video_worker' "$DATA/anoncat.toml" \
		&& ! grep -q '^media_video_thumbnail_command.*protocol_whitelist' "$DATA/anoncat.toml"; then
		sed -i 's/^\(media_video_thumbnail_command = .*\)"-i", "{input}"/\1"-protocol_whitelist", "file", "-format_whitelist", "mov,mp4,m4a,3gp,3g2,mj2,matroska,webm,ogg,avi,mpegts,flv", "-i", "{input}"/' "$DATA/anoncat.toml"
		echo "config: ffmpeg limited to the staged file and common video formats"
	fi
	if grep -qxE 'max_request_size = "(512 MiB|1 GiB)"' "$DATA/anoncat.toml" \
		&& ! grep -q '^max_upload_size' "$DATA/anoncat.toml"; then
		sed -i -E 's/^max_request_size = "(512 MiB|1 GiB)"$/max_request_size = "24 MiB"\nmax_upload_size = "1 GiB"/' "$DATA/anoncat.toml"
		echo "config: requests limited to 24 MiB, uploads with a sign-in up to 1 GiB"
	fi
	if ! grep -q '^client_request_timeout' "$DATA/anoncat.toml"; then
		sed -i '/^max_request_size/a\
\
# Longest a request may take, upload included (seconds). 30 minutes lets a\
# 1 GiB upload finish on a slow phone connection through the VPN.\
client_request_timeout = 1800' "$DATA/anoncat.toml"
		echo "config: added client_request_timeout"
	fi
fi
chown -R "$USER_:$USER_" "$DATA"

step "Firewall"
# Persisted in FerroOS's file and added live; the file isn't reloaded, since
# its `flush ruleset` would also drop wg-quick's rules.
# Behind the relay (anoncat-relay), nothing comes in on wg0 any more, so the
# port-forward rule isn't added back.
if [[ -f /etc/anoncat/relay.env ]]; then
	echo "relay in use: no port-forward rule"
elif ! grep -qF "$INPUT_RULE" /etc/nftables.conf; then
	cp -p /etc/nftables.conf "/etc/nftables.conf.before-anoncat"
	sed -i "s|^\(\s*\)iif \"lo\" accept$|&\n\1# anoncat: the forwarded port, redirected to 8448 by anoncat-netd\n\1$INPUT_RULE|" /etc/nftables.conf
	grep -qF "$INPUT_RULE" /etc/nftables.conf || die "couldn't add the input rule to /etc/nftables.conf"
	nft -c -f /etc/nftables.conf || die "/etc/nftables.conf no longer parses; the original is /etc/nftables.conf.before-anoncat"
	echo "added to /etc/nftables.conf (backup: /etc/nftables.conf.before-anoncat)"
fi
if [[ ! -f /etc/anoncat/relay.env ]] && ! nft list chain inet filter input | grep -qF "$INPUT_RULE"; then
	nft add rule inet filter input "$INPUT_RULE"
	echo "added to the running firewall"
fi

step "Memory: zram swap (in RAM, nothing written to disk)"
if ! command -v zramswap &>/dev/null; then
	apt-get install -y zram-tools
fi
cat > /etc/default/zramswap <<'ZRAM'
# Compressed swap in RAM: nothing ever reaches a disk.
ALGO=zstd
PERCENT=25
PRIORITY=100
ZRAM
systemctl restart zramswap
swapon --show

step "Start"
# reenable: picks up changed [Install] sections too.
systemctl reenable anoncat.socket anoncat.service anoncat-tls-renew.timer anoncat-backup.timer \
	anoncat-vault-helper.socket anoncat-unlock.service anoncat-reconnect.service \
	anoncat-video.socket
# The unlock page only runs while the vault is locked; it's for after a boot.
systemctl stop anoncat-unlock.service 2>/dev/null || true
systemctl start anoncat-video.socket anoncat.socket
# A server already running keeps its old binary, config and sandbox until it
# restarts; the socket stays open meanwhile, so clients wait, not fail.
if systemctl is-active -q anoncat.service; then
	systemctl restart anoncat.service
else
	systemctl start anoncat.service
fi
systemctl start anoncat-tls-renew.timer anoncat-backup.timer anoncat-vault-helper.socket
# netd is a script: a running copy keeps the old code until restarted.
systemctl try-restart anoncat-netd.service
echo "waiting for anoncat to be ready..."
for _ in $(seq 120); do
	[[ $(systemctl show -P ActiveState anoncat.service) == active ]] && break
	[[ $(systemctl show -P ActiveState anoncat.service) == failed ]] && break
	sleep 1
done
systemctl --no-pager status anoncat.service anoncat-netd.service | grep -E "●|Active:" || true
echo
echo "Logs:   journalctl --namespace=anoncat -f"
echo "Panel:  http://127.0.0.1:8450/_anoncat/panel/ (after a boot it's the unlock page)"
echo "Backup: once, as root: anoncat-backup header /path/off/this/machine/anoncat-luks-header.img"
echo "Next:   register your account first in a Matrix app, with the token above (it becomes the admin;"
echo "        an account made on the web sign-up page never does)."
echo "        Once everything works, delete the copies outside the vault:"
echo "        $OLD_TLS and $OLD_KEY"
