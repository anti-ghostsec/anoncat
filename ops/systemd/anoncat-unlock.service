# The panel's unlock screen while the vault is locked (after every boot): a
# passphrase page on the panel's address, 127.0.0.1:8450, that hands the
# passphrase to anoncat-vault-helper. After an unlock, anoncat-start.service
# stops this before starting anoncat (they share the address); `anoncat-vault
# lock` starts it again.
[Unit]
Description=anoncat unlock page
ConditionPathIsMountPoint=!/Drives/server/data
Wants=anoncat-vault-helper.socket
After=anoncat-vault-helper.socket

[Service]
User=anoncat
Group=anoncat
ExecStart=/usr/bin/python3 -I /usr/local/lib/anoncat/anoncat-unlock-page
Restart=on-failure
RestartSec=5
LimitCORE=0

# Loopback only.
RestrictNetworkInterfaces=lo
IPAddressAllow=localhost
IPAddressDeny=any
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=disconnected
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
CPUAffinity=0-3

[Install]
WantedBy=multi-user.target
