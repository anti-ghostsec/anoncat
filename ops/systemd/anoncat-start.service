# Started by `anoncat-vault unlock --stdin` (the unlock page's path): stops
# the unlock page, which holds the panel's address, then starts anoncat. A
# separate unit so the order is systemd's to keep, and the unlock page still
# gets to answer the browser before it goes.
[Unit]
Description=Start anoncat after an unlock from the unlock page
Conflicts=anoncat-unlock.service
After=anoncat-unlock.service
ConditionPathIsMountPoint=/Drives/server/data

[Service]
# No core dumps: one holds what the process had in memory, decrypted, and
# would be written outside the vault.
LimitCORE=0
Type=oneshot
ExecStart=/usr/bin/systemctl start --no-block anoncat.socket anoncat.service
