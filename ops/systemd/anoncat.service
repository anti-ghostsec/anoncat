# anoncat homeserver.
#
# Its data lives in the passphrase-only vault (ops/vault/anoncat-vault), so
# it can't start until someone unlocks that after a boot; `anoncat-vault
# unlock` starts it. Install: copy to /etc/systemd/system/, then
# `systemctl daemon-reload && systemctl enable anoncat`.
[Unit]
Description=anoncat Matrix homeserver
After=network-online.target ferro-drives.service anoncat.socket
Wants=network-online.target
Requires=anoncat.socket
RequiresMountsFor=/Drives/server/data
# Locked vault: skip quietly instead of starting on an empty directory.
ConditionPathIsMountPoint=/Drives/server/data

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
Environment="MALLOC_CONF=background_thread:false"
User=anoncat
Group=anoncat
ExecStart=/usr/local/bin/anoncat -c /Drives/server/data/anoncat.toml
ExecReload=/bin/kill -s USR1 $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStartSec=10min
TimeoutStopSec=2min

# This PC loses power when load spreads past ~5 cores.
CPUAffinity=0-3
CPUQuota=400%

# Hardening: nothing outside the vault is writable.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/Drives/server/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateUsers=yes
PrivateIPC=yes
RemoveIPC=yes
ProtectProc=invisible
DevicePolicy=closed
ManagedOOMPreference=avoid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
