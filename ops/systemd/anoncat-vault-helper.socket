# The root helper behind the panel's unlock page. Only root and the anoncat
# group can connect (the helper also checks the peer is the anoncat user);
# one connection at a time, each handled by a fresh helper.
[Unit]
Description=anoncat vault unlock helper socket

[Socket]
ListenStream=/run/anoncat-vault.sock
SocketUser=root
SocketGroup=anoncat
SocketMode=0660
Accept=yes
MaxConnections=1
# No trigger limit: hitting one leaves the socket failed until root restarts
# it (a few reloads of the unlock page would do). One connection at a time,
# argon2 and the helper's delay after a wrong passphrase do the throttling.
TriggerLimitIntervalSec=0

[Install]
WantedBy=sockets.target
