# Keeps anoncat's Let's Encrypt certificate current (anoncat-tls: a new one
# when it lacks a name, a renewal under 30 days left), then restarts anoncat
# in place to load it.
[Unit]
Description=Renew anoncat's TLS certificate
RequiresMountsFor=/Drives/server/data
ConditionPathIsMountPoint=/Drives/server/data

[Service]
# No core dumps: one holds what the process had in memory, decrypted, and
# would be written outside the vault.
LimitCORE=0
Type=oneshot
User=anoncat
Group=anoncat
Environment=EXEC_PATH=/usr/local/lib/anoncat/acme-dynu-hook.py
Environment=ANONCAT_DYNU_KEY_FILE=/Drives/server/data/secrets/dynu-key
ExecStart=/usr/local/lib/anoncat/anoncat-tls
# Only after an actual renewal ("+": as root, to reach systemctl).
ExecStartPost=+/bin/sh -c 'if [ -e /Drives/server/data/tls/renewed ]; then rm -f /Drives/server/data/tls/renewed; systemctl reload anoncat.service; fi'

RestrictNetworkInterfaces=lo wg0
BindReadOnlyPaths=/etc/anoncat/resolv.conf:/etc/resolv.conf
LogNamespace=anoncat
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/Drives/server/data/tls
# lego and the hook face the network, and need only the certificates and the
# Dynu key: none of the users' data.
InaccessiblePaths=-/Drives/server/data/db -/Drives/server/data/backups -/Drives/server/data/anoncat.toml -/Drives/server/data/secrets/venice -/Drives/server/data/secrets/codeberg -/Drives/server/data/netd
ProtectHome=yes
PrivateTmp=disconnected
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
CPUAffinity=0-3
