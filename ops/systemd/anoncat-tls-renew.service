# Renews anoncat's Let's Encrypt certificate (DNS-01 through Dynu) when it
# has under 30 days left, then restarts anoncat in place to load it.
[Unit]
Description=Renew anoncat's TLS certificate
RequiresMountsFor=/Drives/server/data
ConditionPathIsMountPoint=/Drives/server/data

[Service]
Type=oneshot
User=anoncat
Group=anoncat
Environment=EXEC_PATH=/usr/local/lib/anoncat/acme-dynu-hook.py
Environment=ANONCAT_DYNU_KEY_FILE=/Drives/server/data/secrets/dynu-key
ExecStart=/usr/bin/lego --accept-tos --path /Drives/server/data/tls \
	--email admin@anoncat.gleeze.com --domains anoncat.gleeze.com \
	--dns exec --dns.disable-cp \
	renew --days 30 --renew-hook "/usr/bin/touch /Drives/server/data/tls/renewed"
# Only after an actual renewal ("+": as root, to reach systemctl).
ExecStartPost=+/bin/sh -c 'if [ -e /Drives/server/data/tls/renewed ]; then rm -f /Drives/server/data/tls/renewed; systemctl reload anoncat.service; fi'

RestrictNetworkInterfaces=lo wg0
BindReadOnlyPaths=/etc/anoncat/resolv.conf:/etc/resolv.conf
LogNamespace=anoncat
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/Drives/server/data/tls
ProtectHome=yes
PrivateTmp=disconnected
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
CPUAffinity=0-3
