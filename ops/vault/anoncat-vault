#!/bin/bash
# anoncat-vault: the passphrase-only encrypted container holding all of
# anoncat's data (database, media, logs, TLS keys).
#
# The data drive itself unlocks automatically with a key stored on this PC,
# so taking the whole PC would expose it. This container has no stored key:
# after every boot it stays locked, and anoncat stays stopped, until someone
# runs `anoncat-vault unlock` and types the passphrase. The key then lives
# only in kernel memory.
#
#   anoncat-vault create [SIZE]   make the container (default 800G), once
#   anoncat-vault unlock          ask the passphrase, mount, start anoncat
#   anoncat-vault unlock --stdin  the same with the passphrase on standard
#                                 input, exactly (no newline), and without
#                                 waiting for anoncat to be ready; used by
#                                 the panel's unlock page via
#                                 anoncat-vault-helper
#   anoncat-vault lock            stop anoncat, unmount, forget the key
#   anoncat-vault status          show whether it is unlocked and how full
#
# Run as root (sudo). The passphrase is read by cryptsetup from the terminal
# (or, with --stdin, from standard input, which this script never reads
# itself); it is never stored, logged or passed on the command line.

set -euo pipefail
PATH=/usr/sbin:/sbin:$PATH

CONTAINER=${ANONCAT_VAULT_FILE:-/Drives/server/vault/anoncat.luks}
MAPPER=anoncat-vault
MOUNT=${ANONCAT_VAULT_MOUNT:-/Drives/server/data}
OWNER=${ANONCAT_VAULT_OWNER:-anoncat}
SERVICE=${ANONCAT_SERVICE:-anoncat.service}
SOCKET=${ANONCAT_SOCKET:-anoncat.socket}
# The page on the panel's address that takes the passphrase while locked.
UNLOCK_PAGE=${ANONCAT_UNLOCK_PAGE:-anoncat-unlock.service}
MOUNT_OPTS=noatime,nodev,nosuid,noexec

die() { echo "anoncat-vault: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "run as root: sudo $0 $*"; }
is_open() { [[ -e /dev/mapper/$MAPPER ]]; }

# The loop device backing the container, if attached.
loop_of() { losetup -j "$CONTAINER" -O NAME -n | head -1; }

# Attaches the container with direct I/O, so its blocks are cached once (by
# the vault's own filesystem and anoncat) rather than again by the drive
# underneath, then opens it.
open_vault() {
	local loop
	loop=$(loop_of)
	[[ -n $loop ]] || loop=$(losetup --find --show --direct-io=on --sector-size 4096 "$CONTAINER")
	cryptsetup open --type luks2 "$@" "$loop" "$MAPPER" || { losetup -d "$loop"; return 1; }
}
is_mounted() { mountpoint -q "$MOUNT"; }
have_service() { systemctl cat "$SERVICE" &>/dev/null; }

create() {
	local size=${1:-800G}
	is_open && die "/dev/mapper/$MAPPER is already open"
	if [[ -e $CONTAINER ]]; then
		cryptsetup isLuks "$CONTAINER" \
			&& die "$CONTAINER is already a vault; refusing to overwrite it"
		# No LUKS header: a create that didn't finish, or a damaged vault whose
		# header might still be restored from a backup. Kept, never deleted.
		local kept
		kept="$CONTAINER.broken-$(date +%Y%m%d-%H%M%S)"
		mv "$CONTAINER" "$kept"
		echo "Moved $CONTAINER (no LUKS header) to $kept; delete it once you're sure it's not needed."
	fi

	echo "Creating a $size container at $CONTAINER."
	echo "Choose a strong passphrase you will not forget: without it the data is gone."
	echo "cryptsetup will ask you to confirm by typing YES in capital letters."
	install -d -m 0700 "$(dirname "$CONTAINER")"
	# Allocated up front, so it can't fail later on a full disk.
	fallocate -l "$size" "$CONTAINER"
	chmod 0600 "$CONTAINER"

	# Until the container is formatted, a failure removes it again.
	trap 'cryptsetup isLuks "$CONTAINER" 2>/dev/null || rm -f "$CONTAINER"' EXIT
	cryptsetup luksFormat --type luks2 --pbkdf argon2id --iter-time 4000 \
		--label anoncat-vault --verify-passphrase "$CONTAINER"
	trap - EXIT

	open_vault
	mkfs.ext4 -q -m 0 -L anoncat-data "/dev/mapper/$MAPPER"
	mount_it
	echo "Created and unlocked. anoncat's data goes in $MOUNT."
}

mount_it() {
	install -d -m 0700 -o "$OWNER" -g "$OWNER" "$MOUNT"
	e2fsck -p "/dev/mapper/$MAPPER" >/dev/null || [[ $? -le 1 ]] \
		|| die "filesystem check found errors; run e2fsck -f /dev/mapper/$MAPPER by hand"
	mount -o "$MOUNT_OPTS" "/dev/mapper/$MAPPER" "$MOUNT"
	chown "$OWNER:$OWNER" "$MOUNT"
	chmod 0700 "$MOUNT"
}

unlock() {
	local from_stdin=${1:-}
	[[ -e $CONTAINER ]] || die "no container at $CONTAINER; run: $0 create"
	if ! is_open; then
		if [[ $from_stdin == --stdin ]]; then
			# cryptsetup reads the passphrase from stdin itself, to EOF.
			open_vault --key-file=-
		else
			# Up to three tries, then cryptsetup gives up.
			open_vault --tries 3
		fi
	fi
	is_mounted || mount_it
	echo "Unlocked: $MOUNT"
	if have_service; then
		if [[ $from_stdin == --stdin ]]; then
			# The caller is the unlock page, which holds the panel's address:
			# anoncat-start.service stops it, then starts anoncat. Not waited
			# for, so the page can still answer.
			systemctl start --no-block anoncat-start.service
			echo "Starting $SERVICE"
		else
			# The unlock page holds the panel's address; anoncat needs it.
			systemctl stop "$UNLOCK_PAGE" 2>/dev/null || true
			systemctl start "$SOCKET" "$SERVICE"
			echo "Started $SERVICE"
		fi
	fi
}

lock() {
	# The socket too: a connection arriving before the unmount would start the
	# server again and keep the vault busy.
	if have_service; then
		systemctl stop "$SOCKET" "$SERVICE"
		echo "Stopped $SERVICE"
	fi
	if is_mounted; then
		umount "$MOUNT" || die "can't unmount $MOUNT; something still uses it (see: fuser -vm $MOUNT)"
	fi
	if is_open; then
		cryptsetup close "$MAPPER"
	fi
	local loop
	loop=$(loop_of)
	[[ -z $loop ]] || losetup -d "$loop"
	echo "Locked."
	if systemctl cat "$UNLOCK_PAGE" &>/dev/null; then
		systemctl start --no-block "$UNLOCK_PAGE"
		echo "Unlock page: http://127.0.0.1:8450/_anoncat/panel/"
	fi
}

status() {
	if is_mounted; then
		echo "unlocked, mounted at $MOUNT"
		df -h --output=size,used,avail,pcent "$MOUNT" | tail -1
		local loop
		loop=$(loop_of)
		[[ -z $loop ]] || echo "direct I/O: $(cat "/sys/block/${loop#/dev/}/loop/dio")"
	elif is_open; then
		echo "unlocked but not mounted"
	elif [[ -e $CONTAINER ]]; then
		echo "locked"
	else
		echo "not created"
	fi
}

cmd=${1:-status}
shift || true
case $cmd in
	create) need_root create; create "$@" ;;
	unlock)
		need_root unlock
		[[ $# -eq 0 || $1 == --stdin ]] || die "usage: $0 unlock [--stdin]"
		unlock "$@" ;;
	lock) need_root lock; lock ;;
	status) status ;;
	*) sed -n '2,26p' "$0"; exit 2 ;;
esac
